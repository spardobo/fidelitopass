{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "format": "vp fmt \"resources/js/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"*.js\" --write",
        "check:format": "vp fmt \"resources/js/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"*.js\" --check",
        "check:lint": "vp lint resources/js scripts tests *.js",
        "check:documentation": "node scripts/quality/documentation/validate-documentation.mjs",
        "check:playwright-runtime": "node scripts/quality/browser/check-playwright-runtime.mjs",
        "test": "node --test \"scripts/quality/**/*.test.mjs\"",
        "test:documentation-validator": "node --test scripts/quality/documentation/validate-documentation.test.mjs",
        "test:e2e": "playwright test",
        "test:e2e:list": "playwright test --list",
        "prepare": "husky",
        "test:regional-dates": "node --test tests/JavaScript/regional-dates.test.mjs"
    },
    "dependencies": {
        "@fontsource-variable/onest": "^5.3.1",
        "@laravel/passkeys": "^0.4.0",
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.7",
        "vite": "^8.3.0",
        "vite-plus": "1.1.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.4",
        "@rollup/rollup-linux-x64-gnu": "4.63.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "husky": "^9.1.7"
    },
    "overrides": {
        "concurrently": {
            "shell-quote": "1.11.0"
        }
    }
}
